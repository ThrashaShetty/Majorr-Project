# Copy to .env and fill in. No real secrets are stored in this repository.
# Path to the SAM ViT-B checkpoint (not in git; download from the official segment-anything release).
MEDSAM_CHECKPOINT=checkpoints/sam_vit_b_01ec64.pth
# cpu | cuda | auto
MEDSAM_DEVICE=cpu
# SQLite experiment-history database for the main API
MEDSAM_DB=experiments.db
# Data directory for the exploratory extensions API
MEDSAM_EXT_DATA=app_data
